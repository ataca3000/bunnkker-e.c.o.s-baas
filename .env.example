# ─── Base de Datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bunkker_db

# ─── Seguridad / HMAC ─────────────────────────────────────────────────────────
# REQUERIDO en producción. Secreto para firmar cookies de rol (HMAC-SHA256).
# Genera uno seguro con: openssl rand -hex 64
INTERNAL_API_SECRET=

# ─── Licencias ───────────────────────────────────────────────────────────────
# Salt secreto para generar PINs de activación offline.
# Genera uno con: openssl rand -hex 32
LICENSE_PIN_SALT=

# ─── Firebase (Cliente — NEXT_PUBLIC_*) ───────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (Servidor — NO exponer al cliente) ────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Redis ───────────────────────────────────────────────────────────────────
# Opcional. Sin esta variable se usa almacén en memoria (no apto para multi-instancia).
REDIS_URL=

# ─── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── MercadoPago ─────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=

# ─── Facturapi ────────────────────────────────────────────────────────────────
FACTURAPI_SECRET_KEY=

# ─── Entorno de la App ────────────────────────────────────────────────────────
# Valores: demo | local | nube
# demo: landing pública, local: exe offline (SQLite), nube: Firebase PRO
NEXT_PUBLIC_APP_ENV=local

# ─── Electron / Hardware ──────────────────────────────────────────────────────
# ID de máquina físico para licencias en Electron (opcional, lo genera automáticamente)
MACHINE_HWID=

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── GitHub (Integración webhook) ─────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
