# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Public Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (Server Side)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe for Payments
STRIPE_SECRET_KEY=

# Facturapi for CFDI Invoicing
FACTURAPI_KEY=

# Admin & Notifications
ADMIN_EMAIL=
GMAIL_USER=
GMAIL_PASS=

# ── SEGURIDAD CRÍTICA ─────────────────────────────────────────────────────────
# INTERNAL_API_SECRET: REQUERIDO en producción.
# Genera un secreto aleatorio fuerte: openssl rand -hex 32
# SIN este valor, el servidor RECHAZA todas las sesiones en producción.
INTERNAL_API_SECRET=

# DEV_SECRET: Secreto para operaciones de administración del servidor (SOLO servidor).
# NUNCA usar NEXT_PUBLIC_* para secretos de admin — quedan expuestos en el bundle.
DEV_SECRET=

# LICENSE_PIN_SALT: Salt secreto para generación de PINs offline de activación.
# Genera un valor único: openssl rand -hex 24
# NUNCA compartir este valor. NUNCA hardcodearlo en el código fuente.
LICENSE_PIN_SALT=

# ── Hardware & Machine ID ─────────────────────────────────────────────────────
MACHINE_HWID=

# ── AI Product Classification (Optional) ─────────────────────────────────────
AI_SERVICE_URL=

# ── App URL ───────────────────────────────────────────────────────────────────
APP_URL="MY_APP_URL"

# ── Bridge local Windows / Radio LAN ─────────────────────────────────────────
# URL accesible desde los equipos conectados al mismo Wi‑Fi que el PC servidor.
# Ejemplo: http://192.168.1.50:3002
NEXT_PUBLIC_RADIO_URL="http://192.168.1.50:3002"
NEXT_PUBLIC_RADIO_PORT="3002"

# ── Base de Datos Neon (PostgreSQL) & Vercel Multi-Project ────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.neon.tech/neondb"
POSTGRES_URL="postgresql://user:password@ep-xxxx.us-east-1.neon.tech/neondb"
POSTGRES_HOST="ep-xxxx.us-east-1.neon.tech"
POSTGRES_PASSWORD="your_password"
POSTGRES_POOLING=true
PGUSER="neondb_owner"
NEON_PROJECT_ID="your_project_id"

# ── Stripe & Monetización ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Vercel API (Multi-Project Deployments) ────────────────────────────────────
VERCEL_TOKEN="your_vercel_token"
VERCEL_TEAM_ID="your_team_id"


