rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read, write: if true;
    }

    match /invitations/{document=**} {
      allow read, write: if true;
    }

    match /tenants_registry/{tenantDoc} {
      allow read, write: if true;
    }

    match /radio_channel/{document=**} {
      allow read, write: if true;
    }
    
    match /settings/{doc} {
      allow read, write: if true;
    }

    match /secrets/{doc} {
      allow read, write: if true;
    }

    match /orders/{document=**} {
      allow read, write: if true;
    }
    
    match /products/{document=**} {
      allow read, write: if true;
    }

    match /tracking_fleet/{driverId} {
      allow read, write: if true;
    }
    // Alertas de Pánico
    match /panic_alerts/{document=**} {
      allow read, write: if true;
    }

    // Logs de Auditoría
    match /audit_logs/{document=**} {
      allow read, write: if true;
    }
  }
}
