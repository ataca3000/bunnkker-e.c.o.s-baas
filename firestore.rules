rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─────────────────────────────────────────────────────────────────────────
    // ARQUITECTURA: Firebase opera únicamente como repositorio de respaldo de datos.
    // Todas las validaciones de seguridad, integridad y negocio se aplican localmente.
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
