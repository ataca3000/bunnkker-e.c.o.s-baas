# BUNKKER E.C.O.S - configuración local Windows
# Copia este archivo como .env.local y completa los valores necesarios.

# Base de datos PostgreSQL/Neon para la aplicación
DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"

# Firma compartida para sesiones internas
INTERNAL_API_SECRET="genera-un-secreto-largo-y-aleatorio"

# Radio LAN del PC servidor
RADIO_PORT="3002"
NEXT_PUBLIC_RADIO_URL="http://192.168.1.100:3002"
RADIO_ALLOWED_ORIGIN="https://tu-dominio.vercel.app"

# Stripe: solo activar cuando existan Price IDs reales
NEXT_PUBLIC_STRIPE_PRICE_LOCAL="price_xxx"
NEXT_PUBLIC_STRIPE_PRICE_HYBRID="price_xxx"
NEXT_PUBLIC_STRIPE_PRICE_P2P="price_xxx"
