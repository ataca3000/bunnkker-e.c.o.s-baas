{
  "name": "bunkker-e.c.o.s-erp",
  "version": "1.0.0",
  "description": "bunkker ERP — Ecosistema Comercial de Operaciones Simplificadas",
  "author": "brechasolucionesds",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "npx concurrently \"next dev -p 3000\" \"node radio-server.js\"",
    "dev:https": "next dev --experimental-https -p 3000",
    "build": "prisma generate && next build",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "guard:build": "node scripts/build-guard.js",
    "start": "concurrently \"node scripts/restore-node-modules.js && node .next/standalone/server.js\" \"node radio-server.js\"",
    "lint": "eslint .",
    "dev:electron": "electron .",
    "build:web": "node ./scripts/run-next-build.js web nube",
    "build:demo": "node ./scripts/run-next-build.js web demo",
    "build:standalone": "node ./scripts/run-next-build.js desktop local && node copy-standalone.js",
    "build:secure": "npm run build:standalone",
    "dist": "npm run build:secure && electron-builder",
    "dist:win": "npm run build:standalone && electron-builder --win --x64",
    "dist:publish": "npm run build:standalone && electron-builder --win --publish always",
    "emulate:local": "firebase emulators:start --import=./firebase_data --export-on-exit",
    "bridge:windows": "node radio-server.js",
    "validate:ports": "node src/lib/check-ports.js",
    "validate:comm": "node src/lib/validate-comm.js",
    "test:logic": "node scripts/test-logic.js",
    "test": "vitest run",
    "update:file": "node scripts/update-file.js"
  },
  "build": {
    "appId": "com.bunkkererp.erp",
    "productName": "Camalion Topics ERP",
    "copyright": "Copyright © 2026 brecha soluciones ds bunkker e.c.o.s",
    "directories": {
      "output": "dist-build-win",
      "buildResources": "build-resources"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "server/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "bunkker ERP"
    },
    "publish": {
      "provider": "github",
      "owner": "ataca3000",
      "repo": "camalion-topics-erp",
      "private": true
    }
  },
  "dependencies": {
    "@dataconnect/admin-generated": "file:src/dataconnect-admin-generated",
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.8.0",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^2.0.1",
    "ajv": "^8.12.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "facturapi": "^4.18.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.40.0",
    "html5-qrcode": "^2.3.8",
    "immer": "^10.2.0",
    "ioredis": "^5.11.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "mercadopago": "^3.1.0",
    "multicast-dns": "^7.2.5",
    "next": "^15.5.21",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^9.0.1",
    "openai": "^4.85.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-qr-code": "^2.0.18",
    "react-resizable": "^4.0.2",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-webcam": "^7.2.0",
    "react-window": "^1.8.10",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.4.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.1",
    "workbox-precaching": "^7.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/multicast-dns": "^7.2.2",
    "@types/natural": "^5.1.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^5.22.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "nanoid": "^3.3.8",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "serialize-javascript": "^7.0.5",
    "postcss": "^8.5.10",
    "axios": "^1.7.9",
    "fast-xml-parser": "^5.10.1",
    "shell-quote": "^1.9.0",
    "next": "^15.5.21",
    "vitest": "^4.1.9",
    "brace-expansion": "^2.1.3",
    "sharp": "^0.35.0",
    "uuid": "^11.1.1",
    "protobufjs": "^7.6.5",
    "fast-uri": "^3.0.3"
  }
}
