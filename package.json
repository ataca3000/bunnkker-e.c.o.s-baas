{
  "name": "bunkker-e.c.o.s-erp",
  "version": "1.0.0",
  "description": "BUNKKER E.C.O.S. — ERP/POS local-first con sincronización LAN, dashboard multirol y billing SaaS.",
  "author": "brechasolucionesds",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next dev -p 3000 -H 0.0.0.0",
    "dev:https": "next dev --experimental-https -p 3000",
    "build": "node ./scripts/prepare-db.js && prisma generate && next build",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "guard:build": "node scripts/build-guard.js",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "dev:electron": "electron .",
    "build:web": "node ./scripts/run-next-build.js web nube",
    "build:demo": "prisma generate && node ./scripts/run-next-build.js web demo",
    "build:standalone": "node ./scripts/run-next-build.js desktop local && node scripts/copy-standalone.js",
    "build:secure": "npm run build:standalone",
    "dist": "npm run build:secure && electron-builder",
    "dist:win": "npm run build:standalone && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "win": "npm run dist:win",
    "dist:publish": "npm run build:standalone && electron-builder --win --publish always",
    "emulate:local": "firebase emulators:start --import=./firebase_data --export-on-exit",
    "deploy:firebase": "node scripts/deploy-firebase.js",
    "bridge:windows": "node radio-server.js",
    "validate:ports": "node src/lib/check-ports.js",
    "validate:comm": "node src/lib/validate-comm.js",
    "test:logic": "node scripts/test-logic.js",
    "test": "vitest run",
    "update:file": "node scripts/update-file.js",
    "migrate:pins": "node scripts/migrate-pins.js",
    "migrate:pins:dry": "node scripts/migrate-pins.js --dry-run",
    "validate:schemas": "node scripts/validate-schemas.js",
    "optimize": "node --expose-gc scripts/optimize-system.mjs"
  },
  "build": {
    "appId": "com.bunkkererp.erp",
    "productName": "BUNKKER E.C.O.S ERP",
    "electronDist": "node_modules/electron/dist",
    "copyright": "Copyright © 2026 brecha soluciones ds bunkker e.c.o.s",
    "directories": {
      "output": "dist-build-win",
      "buildResources": "build-resources"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "server/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "bunkker ERP"
    },
    "publish": {
      "provider": "github",
      "owner": "BRECHACORP",
      "repo": "bunnkker-e.c.o.s-baas",
      "private": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@flags-sdk/vercel": "^1.5.2",
    "@google/genai": "^3.3.0",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.8.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.186.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/toolbar": "^0.2.7",
    "ai": "^7.0.146",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "facturapi": "^4.18.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.2.0",
    "flags": "^4.3.1",
    "framer-motion": "^12.40.0",
    "html5-qrcode": "^2.3.8",
    "immer": "^10.2.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "mercadopago": "^3.1.0",
    "multicast-dns": "^7.2.5",
    "next": "^15.5.21",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^10.1.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-qr-code": "^2.0.18",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-webcam": "^7.2.0",
    "react-window": "^1.8.10",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.2.2",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.4.1",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.24",
    "@tailwindcss/postcss": "^4.0.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/multicast-dns": "^7.2.2",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "nanoid": "^3.3.16",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "serialize-javascript": "^7.0.5",
    "postcss": "^8.5.31",
    "axios": "^1.20.0",
    "fast-xml-parser": "^5.10.1",
    "shell-quote": "^1.9.0",
    "next": "^15.5.21",
    "sharp": "^0.35.0",
    "uuid": "^11.1.1",
    "protobufjs": "^7.6.5",
    "fast-uri": "^3.1.9",
    "@grpc/grpc-js": "^1.14.5",
    "engine.io": "^6.6.10",
    "tinypool": "^2.1.2",
    "sprintf-js": "^1.1.3",
    "vite": "^6.4.3",
    "launch-editor": "^3.0.1",
    "esbuild": "^0.25.0",
    "@vitest/mocker": "^4.1.12",
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
