{
  "name": "bunkker-ecos-erp",
  "version": "1.0.0",
  "description": "E.C.O.S (Ecosistema Comercial de Operaciones Simplificadas)",
  "author": "BRECHA SOLUCIONES S.A de C.V",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:https": "next dev --experimental-https -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "dev:electron": "electron .",
    "build:standalone": "next build && node copy-standalone.js",
    "obfuscate": "javascript-obfuscator ./electron-main.js --output ./electron-main.obf.js --target node --compact true --self-defending false --dead-code-injection false",
    "build:secure": "npm run build:standalone",
    "dist": "npm run build:secure && electron-builder",
    "dist:win": "npm run build:standalone && electron-builder --win --x64",
    "dist:publish": "npm run build:standalone && electron-builder --win --publish always",
    "emulate:local": "firebase emulators:start --import=./firebase_data --export-on-exit",
    "validate:ports": "node src/lib/check-ports.js",
    "validate:comm": "node src/lib/validate-comm.js",
    "test:logic": "node scripts/test-logic.js",
    "test": "vitest run",
    "update:file": "node scripts/update-file.js"
  },
  "build": {
    "appId": "com.bunkker.ecos",
    "productName": "BUNKKER E.C.O.S",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.8.0",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.8.9",
    "facturapi": "^4.18.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.0.0",
    "framer-motion": "^12.40.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "mercadopago": "^3.1.0",
    "next": "^15.5.19",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^9.0.1",
    "prisma": "^5.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "react-qr-code": "^2.0.18",
    "react-resizable": "^4.0.2",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-webcam": "^7.2.0",
    "react-window": "^1.8.10",
    "recharts": "^3.8.1",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.4.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "workbox-precaching": "^7.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@tailwindcss/postcss": "^4.0.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/multicast-dns": "^7.2.2",
    "@types/natural": "^5.1.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9",
    "webpack-obfuscator": "^3.6.1"
  }
}
