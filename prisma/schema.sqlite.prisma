generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Catálogo Local
model Customer {
  id            String   @id @default(uuid())
  tenantId      String   @default("default")
  name          String
  phone         String   @unique
  email         String?
  address       String?
  references    String?
  gpsCoords     String?
  pin           String?
  rfc           String?
  razonSocial   String?
  regimenFiscal String?
  usoCFDI       String?
  codigoPostal  String?
  createdAt     DateTime @default(now())
  orders        Order[]
}

model Product {
  id            String      @id
  tenantId      String      @default("default")
  name          String
  price         Float
  stock         Int         @default(0)
  reservedStock Int         @default(0)
  category      String?
  image         String?
  rating        Float?
  reviewCount   Int?
  barcode       String?
  description   String?
  estante       String?
  fila          String?
  orderIndex    Int         @default(0)
  deletedAt     DateTime?
  orderItems    OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  tenantId      String      @default("default")
  total         Float
  paymentMethod String
  status        String      @default("paid")
  deliveryType  String      @default("LOCAL")
  date          DateTime    @default(now())
  expiresAt     DateTime?
  offline       Boolean     @default(true)
  synced        Boolean     @default(false)
  ventanilla    String?
  cajon         String?
  vendedorId    String?
  vendedorName  String?
  confirmedAt   DateTime?
  // Datos operativos del flujo de preparación, patio y reparto
  deliveryPin   String?
  deliveryLat   Float?
  deliveryLng   Float?
  deliveryAddress String?
  loadedBy      String?
  loadedByUid   String?
  loadingStartedAt DateTime?
  loadingFinishedAt DateTime?
  isLoaded      Boolean     @default(false)
  assignedDriverId String?
  signatureData String?
  photoData     String?
  completedAt   DateTime?
  rejectionReason String?

  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  events        OrderEvent[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  cantidad  Int
  precio    Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model OrderEvent {
  id         String   @id @default(uuid())
  orderId    String
  eventType  String
  fromStatus String?
  toStatus   String?
  actorId    String
  actorName  String
  actorRole  String
  details    String?
  createdAt  DateTime @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
}

model SyncQueue {
  id         String   @id @default(uuid())
  collection String
  documentId String?
  action     String
  payload    String
  createdAt  DateTime @default(now())
  status     String   @default("PENDING")
  errorMsg   String?
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String
  timestamp DateTime @default(now())
  synced    Boolean  @default(false)
}

model SupportTicket {
  id            String   @id @default(uuid())
  folio         String   @unique
  customerEmail String
  customerName  String
  message       String
  status        String   @default("Pendiente")
  createdAt     DateTime @default(now())
  synced        Boolean  @default(false)
}

model Purchase {
  id        String   @id @default(uuid())
  supplier  String
  concept   String
  amount    Float
  status    String   @default("Pendiente")
  createdAt DateTime @default(now())
  synced    Boolean  @default(false)
}

model CashRegisterLog {
  id             String   @id @default(uuid())
  tenantId       String
  cashierId      String
  cashierName    String
  declaredAmount Float
  expectedAmount Float
  discrepancy    Float
  createdAt      DateTime @default(now())
  synced         Boolean  @default(false)
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  pin       String   @unique
  pinHash   String?
  deviceId  String?
  role      String   @default("sales")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  synced    Boolean  @default(false)
}

model ShrinkageLog {
  id              String   @id @default(uuid())
  productId       String
  productName     String
  productCategory String
  discrepancyType String
  qty             Int
  estimatedLoss   Float
  notes           String
  reportedBy      String
  createdAt       DateTime @default(now())
}

model AppConfig {
  id             String    @id @default("global")
  licenseType    String    @default("TRIAL")
  tenantId       String?
  cloudToken     String?
  pairedAt       DateTime?
  lastBackupAt   DateTime?
  lastBackupSize Int?
  lastBackupHash String?
  updatedAt      DateTime  @updatedAt
}

model SwarmTransaction {
  id               String   @id @default(uuid())
  requestingNode   String
  providingNode    String
  productId        String
  qty              Int
  reservedAt       DateTime @default(now())
  expiresAt        DateTime
  status           String   @default("RESERVED")
  commissionEarned Float    @default(0)
}
