{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with roles",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["customer", "node", "delivery", "admin", "superadmin"] },
        "name": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["role"]
    },
    "Address": {
      "title": "Address",
      "description": "Shipping address",
      "type": "object",
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zip": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Saved payment method",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "last4": { "type": "string" },
        "expiry": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Sales order",
      "type": "object",
      "properties": {
        "total": { "type": "number" },
        "customerEmail": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/users/{userId}/addresses/{addressId}": { "schema": "Address", "description": "User shipping addresses" },
    "/users/{userId}/payment_methods/{methodId}": { "schema": "PaymentMethod", "description": "User saved payment methods" },
    "/products/{productId}": { "schema": "Product", "description": "Inventory items" },
    "/orders/{orderId}": { "schema": "Order", "description": "Client orders" }
  }
}
