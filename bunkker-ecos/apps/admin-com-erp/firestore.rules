rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funciones de validación de RBAC
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isStaff() {
      return isSignedIn() && (
        getUserData().role in ['superadmin', 'admin', 'inventory', 'sales', 'billing', 'marketing', 'carga_descarga', 'driver']
      );
    }
    
    function isSuperadmin() {
      return hasRole('superadmin');
    }

    match /users/{userId} {
      allow read: if isStaff() || request.auth.uid == userId;
      allow write: if isSuperadmin() || request.auth.uid == userId;
    }

    match /invitations/{document=**} {
      allow read, write: if isSuperadmin();
    }

    match /tenants_registry/{tenantDoc} {
      allow read: if isSignedIn();
      allow write: if isSuperadmin();
    }

    match /radio_channel/{document=**} {
      allow read, write: if isStaff();
    }
    
    match /settings/{doc} {
      allow read: if true;
      allow write: if isSuperadmin() || hasRole('marketing');
    }

    match /secrets/{doc} {
      allow read, write: if isSuperadmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isStaff();
    }
    
    match /products/{document=**} {
      allow read: if true;
      allow write: if hasRole('superadmin') || hasRole('admin') || hasRole('inventory') || hasRole('marketing') || hasRole('sales');
    }

    match /tracking_fleet/{driverId} {
      allow read: if isStaff() || isSignedIn();
      allow write: if isSuperadmin() || request.auth.uid == driverId;
    }

    match /panic_alerts/{document=**} {
      allow create: if isStaff();
      allow read, update, delete: if isSuperadmin() || hasRole('admin');
    }

    match /audit_logs/{document=**} {
      allow create: if isStaff();
      allow read: if isSuperadmin() || hasRole('admin');
      allow update, delete: if false; 
    }
  }
}
