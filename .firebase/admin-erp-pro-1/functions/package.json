{
  "name": "camalion-topics-erp",
  "version": "1.0.0",
  "description": "Camalion Topics ERP — Ecosistema Comercial de Operaciones Simplificadas",
  "author": "brechaopensource",
  "private": true,
  "main": "server.js",
  "build": {
    "appId": "com.camaliontopics.erp",
    "productName": "Camalion Topics ERP",
    "copyright": "Copyright © 2026 Camalion Topics S.A. de C.V.",
    "directories": {
      "output": "dist-build-win",
      "buildResources": "build-resources"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "server/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Camalion Topics ERP"
    },
    "publish": {
      "provider": "github",
      "owner": "ataca3000",
      "repo": "camalion-topics-erp",
      "private": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.8.0",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.12.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cosine-similarity": "^1.0.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "facturapi": "^4.18.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.1.0",
    "framer-motion": "^12.40.0",
    "html5-qrcode": "^2.3.8",
    "immer": "^10.2.0",
    "leaflet": "^1.9.4",
    "localtunnel": "^2.0.2",
    "lucide-react": "^1.21.0",
    "mercadopago": "^3.1.0",
    "multicast-dns": "^7.2.5",
    "natural": "^8.0.1",
    "next": "^15.5.19",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^9.0.1",
    "openai": "^4.85.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-qr-code": "^2.0.18",
    "react-resizable": "^4.0.2",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-webcam": "^7.2.0",
    "react-window": "^1.8.10",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.4.1",
    "tmp": "^0.2.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "workbox-precaching": "^7.4.1",
    "zustand": "^5.0.14",
    "firebase-frameworks": "^0.11.0",
    "firebase-functions": "^6.0.1"
  },
  "overrides": {
    "nanoid": "^3.3.8",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "serialize-javascript": "^6.0.2",
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": "24"
  }
}